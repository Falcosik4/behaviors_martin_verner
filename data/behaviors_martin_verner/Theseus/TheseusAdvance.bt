{
  "name": "<unnamed>",
  "id": "b04c68a9-c605-42ba-93c6-0754519da33f",
  "type": "sequence",
  "subtrees": [
    {
      "name": "Setup BB variables",
      "id": "5b5d9e70-74f5-4d3f-9966-60a4ca18b302",
      "type": "scriptAction",
      "script": [
        "bb.path=nil",
        "DebugLog(\"BB Variables set up\")",
        "return SUCCESS"
      ]
    },
    {
      "name": "Root",
      "id": "85607254-1b3f-4c81-8efe-eec95062218b",
      "type": "supervisedParallel",
      "subtrees": [
        {
          "name": "Wait Forever",
          "id": "e8b7e76a-2c09-4ce1-a0ca-26123985cb1b",
          "type": "waitForever"
        },
        {
          "name": "MinotaurPositionUpdate",
          "id": "7c0e707e-d69a-4a96-8b80-0c052ffe1541",
          "type": "messageHandler",
          "subject": "MinotaurPositionUpdate",
          "handler": [
            "if msg.value.position then",
            "\tloc.lastKnownMinotaurPosition = msg.value.position",
            "end"
          ]
        },
        {
          "name": "Shoot or move towards Minotaur",
          "id": "7ae6d39d-ae25-407d-ae8d-b3bffad35dc7",
          "type": "selector",
          "subtrees": [
            {
              "name": "fight",
              "id": "dd7deb64-4a21-4bba-90d7-fdb6206a1d70",
              "type": "sequence",
              "subtrees": [
                {
                  "name": "Aim",
                  "id": "eff7fb73-173c-4e30-8050-a98574e9c465",
                  "type": "scriptAction",
                  "script": [
                    "self:ReqHeadingAimAtEntity(loc.target)"
                  ]
                },
                {
                  "name": "fire within limit",
                  "id": "b954699f-536b-4d69-844c-36b67c2819b6",
                  "type": "parallel",
                  "subtrees": [
                    {
                      "name": "Fire",
                      "id": "6ce9e6e0-3fc2-46dd-a239-e127aa485b65",
                      "type": "fire",
                      "rounds": [
                        "return 30"
                      ],
                      "forced": false
                    },
                    {
                      "name": "Fire",
                      "id": "a33156cb-478f-43a3-8c46-d3f54bf24703",
                      "type": "fire",
                      "decorators": [
                        {
                          "id": "20fb94f0-df37-45f9-8e5f-299e75d81e23",
                          "type": "wait",
                          "name": "2",
                          "time": [
                            "return 1.4"
                          ]
                        }
                      ],
                      "rounds": [
                        "return 10"
                      ],
                      "forced": true
                    }
                  ],
                  "waitForAll": true
                },
                {
                  "name": "Reload",
                  "id": "5138db2c-d1c0-4d51-8f83-39a8b6fb2c5c",
                  "type": "reloadWeapon"
                }
              ],
              "decorators": [
                {
                  "id": "6f3fcc9a-0165-4352-9c84-a1758e1270f7",
                  "type": "scriptCondition",
                  "name": "Can see minotaur ?",
                  "script": [
                    "local nearbyEnemies = GetEntitiesInArea(Circle(self:GetPosition(), self:GetVisibilityRange()), { hasBrain=true, enemyOf=self})",
                    "DebugLog(\"Nearby enemies: \" .. #nearbyEnemies)",
                    "loc.target = nil",
                    "for i,entity in ipairs(nearbyEnemies) do",
                    "    DebugLog(\"-Is visible? \" .. tostring(self:IsVisible(entity)))",
                    "\tif self:IsVisible(entity) then",
                    "\t\tloc.target = entity",
                    "\t    break",
                    "    end",
                    "end",
                    "",
                    "",
                    "DebugLog(\"Has target? \" .. tostring(loc.target ~= nil))",
                    "DebugLog(\"--\")",
                    "",
                    "return loc.target ~= nil"
                  ]
                }
              ]
            },
            {
              "name": "<unnamed>",
              "id": "49936068-1aba-455a-a2e3-117197a011ec",
              "type": "selector",
              "subtrees": [
                {
                  "name": "Succeed",
                  "id": "15c053e1-a0c3-4f89-bde0-f897d238278f",
                  "type": "success",
                  "decorators": [
                    {
                      "id": "43d6a1eb-7620-4f2e-bc14-4fc7806115cd",
                      "type": "valueComparison",
                      "name": "Target not same",
                      "operator": "not equal",
                      "lhs": {
                        "type": "local",
                        "key": "lastKnownMinotaurPosition"
                      },
                      "rhs": {
                        "type": "local",
                        "key": "previousPath"
                      }
                    },
                    {
                      "id": "b56c5ea7-cc3b-4c71-af8f-7850d81083f8",
                      "type": "scriptAction",
                      "name": "Set new path",
                      "script": [
                        "loc.previousPath=loc.lastKnownMinotaurPosition"
                      ]
                    }
                  ]
                },
                {
                  "name": "Move and Wait at Corners",
                  "id": "aaa3bff6-56d9-4379-84c3-9d6575594e6d",
                  "type": "reference",
                  "decorators": [
                    {
                      "id": "01b50376-fcbc-4675-8ff6-1cf285539ea3",
                      "type": "valueComparison",
                      "name": "Target not nil",
                      "operator": "not equal",
                      "lhs": {
                        "type": "local",
                        "key": "lastKnownMinotaurPosition"
                      },
                      "rhs": {
                        "type": "nil"
                      }
                    }
                  ],
                  "target": [
                    "behaviors_martin_verner",
                    "MoveWaitCorners"
                  ],
                  "arguments": {
                    "target": "loc.lastKnownMinotaurPosition"
                  }
                }
              ],
              "active": true
            }
          ],
          "decorators": [
            {
              "id": "0b52440b-29e6-4fee-9925-c33f311e8322",
              "type": "succeeder",
              "name": "Always Succeed"
            }
          ],
          "active": true
        },
        {
          "name": "Hihglight Path",
          "id": "3ee12903-3eb4-4c83-ad01-034e4dad2817",
          "type": "scriptAction",
          "script": [
            "if bb.path ~= nil then",
            "    local num_segments = 20.0",
            "    local segment_step = bb.path:Length() / num_segments",
            "    for i=0, num_segments - 1.0, 1.0 do",
            "        ai_core_public.draw.Line(",
            "        bb.path:PositionAlongPath(i * segment_step),",
            "        bb.path:PositionAlongPath((i+1) * segment_step),",
            "        0, 0, 1, 1",
            "        )",
            "    end",
            "end"
          ]
        }
      ]
    }
  ],
  "unlinked-trees": [
    {
      "name": "Get Target position",
      "id": "6c98ac0a-698b-4a3d-97e8-9a299e2407f1",
      "type": "scriptAction",
      "meta": {
        "nodesInfo": [
          {
            "id": "6c98ac0a-698b-4a3d-97e8-9a299e2407f1",
            "position": "1912.5,1000"
          }
        ],
        "editorObjects": []
      },
      "script": [
        "if #loc.enemies > 0 then",
        "    loc.target = loc.enemies[1]",
        "else loc.target = nil",
        "end"
      ]
    },
    {
      "name": "look for targets",
      "id": "ff48f864-9770-4ea6-8df9-13c9869d8337",
      "type": "scriptAction",
      "meta": {
        "nodesInfo": [
          {
            "id": "ff48f864-9770-4ea6-8df9-13c9869d8337",
            "position": "2650,450"
          }
        ],
        "editorObjects": []
      },
      "script": [
        "-- infantryman soldier override reaction",
        "local visible = self:GetVisibleEnemies(300)",
        "DebugLog(\"visible enemies: \" .. tostring(visible and #visible))",
        "",
        "loc.enemies =#visible > 0 and visible or nil",
        "if loc.enemies == nil then",
        "    return false",
        "end",
        "DebugLog(\"Ja t\u011b vid\u00edm\")",
        "return true"
      ]
    },
    {
      "name": "Target not null",
      "id": "ffa134fe-403b-4939-a1e2-2763ec9b4461",
      "type": "scriptCondition",
      "meta": {
        "nodesInfo": [
          {
            "id": "ffa134fe-403b-4939-a1e2-2763ec9b4461",
            "position": "1912.5,900"
          }
        ],
        "editorObjects": []
      },
      "script": [
        "return loc.target ~=nil"
      ]
    }
  ],
